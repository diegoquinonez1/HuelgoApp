<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HuelgoApp.Mobile.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">
            <Label Text="HuelgoApp" Style="{StaticResource Headline}" />
            <Label x:Name="ConnectionLabel" Text="Comprobando conexión..." Style="{StaticResource SubHeadline}" />
            <Label x:Name="StatusLabel" Text="Inicia sesión o crea una cuenta." />
            <VerticalStackLayout x:Name="RegistrationFields" Spacing="8">
                <Entry x:Name="FirstNameEntry" Placeholder="Nombre" />
                <Entry x:Name="LastNameEntry" Placeholder="Apellido" />
                <DatePicker x:Name="BirthDatePicker" />
            </VerticalStackLayout>
            <Entry x:Name="EmailEntry" Placeholder="Correo electrónico" Keyboard="Email" />
            <Entry x:Name="PasswordEntry" Placeholder="Contraseña" IsPassword="True" />
            <Entry x:Name="ConfirmPasswordEntry" Placeholder="Confirmar contraseña" IsPassword="True" />
            <HorizontalStackLayout Spacing="10">
                <Button Text="Crear cuenta" Clicked="OnRegisterClicked" />
                <Button Text="Iniciar sesión" Clicked="OnLoginClicked" />
            </HorizontalStackLayout>
            <Button x:Name="LogoutButton" Text="Cerrar sesión" IsVisible="False" Clicked="OnLogoutClicked" />
            <Label x:Name="DashboardLabel" IsVisible="False" Text="Sesión activa. El Dashboard financiero se implementará en el Sprint 2." />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
